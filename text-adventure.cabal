cabal-version:      3.0
name:               text-adventure
version:            0.1.0.0
synopsis:           A toolkit for building text adventures
build-type:         Simple

common warnings
  default-language: GHC2021
  default-extensions:
      GADTs
    , RankNTypes
  ghc-options:      -Wall

library
  import:          warnings
  exposed-modules:
      TextAdventure
    , TextAdventure.Core
    , TextAdventure.Ontology
  hs-source-dirs:  lib
  build-depends:
      base >=4.18 && <5
    , text

executable text-adventure
  import:         warnings
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.18 && <5
    , text
    , text-adventure

test-suite text-adventure-test
  import:         warnings
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test
  build-depends:
      base >=4.18 && <5
    , text
    , text-adventure
