cabal-version:      3.0
name:               text-adventure
version:            0.1.0.0
synopsis:           A toolkit for building text adventures
build-type:         Simple

common warnings
  default-language: GHC2021
  default-extensions:
      GADTs
    , RankNTypes
  ghc-options:      -Wall

library
  import:          warnings
  exposed-modules:
      TextAdventure
    , TextAdventure.Core
    , TextAdventure.Ontology
    , TextAdventure.Store.Persistent
  hs-source-dirs:  lib
  build-depends:
      base >=4.18 && <5
    , esqueleto >=3.6 && <3.8
    , monad-logger >=0.3 && <0.4
    , persistent >=2.17 && <2.19
    , persistent-sqlite >=2.13 && <2.14
    , resourcet >=1.3 && <1.4
    , text
    , transformers >=0.6 && <0.7

executable text-adventure
  import:         warnings
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.18 && <5
    , text
    , text-adventure

executable text-adventure-example-minimal
  import:         warnings
  main-is:        Main.hs
  other-modules:  Minimal
  hs-source-dirs: examples/minimal
  build-depends:
      base >=4.18 && <5
    , persistent >=2.17 && <2.19
    , text
    , text-adventure

test-suite text-adventure-test
  import:         warnings
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  other-modules:
      EngineSpec
      Minimal
      MinimalSpec
      PersistentStoreSpec
  hs-source-dirs:
      test
      examples/minimal
  build-depends:
      base >=4.18 && <5
    , filepath
    , persistent
    , temporary
    , text
    , text-adventure
    , transformers >=0.6 && <0.7
